    "/extract_typed_json": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Extract Typed Json",
        "description": "Extract one logical document using an explicit type and complete canonical/draft schemas.",
        "operationId": "extract_typed_json_extract_typed_json_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractTypedJsonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractTypedJsonResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
