  "components": {
    "schemas": {
      "ClassifiedPage": {
        "properties": {
          "document_type": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Type"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "title": "Reason"
          },
          "source_file": {
            "type": "string",
            "title": "Source File"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "source_sha256": {
            "type": "string",
            "title": "Source Sha256"
          },
          "page_sha256": {
            "type": "string",
            "title": "Page Sha256"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_type",
          "confidence",
          "reason",
          "source_file",
          "page",
          "source_sha256",
          "page_sha256",
          "model",
          "cache_hit"
        ],
        "title": "ClassifiedPage"
      },
      "ClassifyJsonRequest": {
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileB64"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Files"
          },
          "document_types": {
            "items": {
              "$ref": "#/components/schemas/DocumentTypeCandidate"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Document Types"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "files",
          "document_types"
        ],
        "title": "ClassifyJsonRequest"
      },
      "ClassifyJsonResponse": {
        "properties": {
          "pages": {
            "items": {
              "$ref": "#/components/schemas/ClassifiedPage"
            },
            "type": "array",
            "title": "Pages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pages"
        ],
        "title": "ClassifyJsonResponse"
      },
      "DocumentTypeCandidate": {
        "properties": {
          "document_type": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Document Type"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_type",
          "description"
        ],
        "title": "DocumentTypeCandidate"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {},
                "type": "array"
              }
            ],
            "title": "Detail",
            "description": "Human-readable reason (422 from FastAPI validation is a list)"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "ExtractTypedJsonRequest": {
        "properties": {
          "files": {
            "items": {
              "$ref": "#/components/schemas/FileB64"
            },
            "type": "array",
            "maxItems": 12,
            "minItems": 1,
            "title": "Files"
          },
          "document_type": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Document Type"
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Schema Version"
          },
          "schema_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Schema Hash"
          },
          "canonical_schema": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Canonical Schema"
          },
          "output_schema": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Output Schema"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "files",
          "document_type",
          "schema_version",
          "schema_hash",
          "canonical_schema",
          "output_schema"
        ],
        "title": "ExtractTypedJsonRequest"
      },
      "ExtractTypedJsonResponse": {
        "properties": {
          "document_type": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Document Type"
          },
          "schema_version": {
            "type": "integer",
            "title": "Schema Version"
          },
          "schema_hash": {
            "type": "string",
            "title": "Schema Hash"
          },
          "status": {
            "type": "string",
            "const": "draft",
            "title": "Status",
            "default": "draft"
          },
          "attributes": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "title": "Attributes"
          },
          "canonical_schema_valid": {
            "type": "boolean",
            "title": "Canonical Schema Valid"
          },
          "canonical_schema_errors": {
            "items": {
              "$ref": "#/components/schemas/SchemaIssue"
            },
            "type": "array",
            "title": "Canonical Schema Errors"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/SourcePage"
            },
            "type": "array",
            "title": "Pages"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "cache_hit": {
            "type": "boolean",
            "title": "Cache Hit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_type",
          "schema_version",
          "schema_hash",
          "attributes",
          "canonical_schema_valid",
          "canonical_schema_errors",
          "pages",
          "model",
          "cache_hit"
        ],
        "title": "ExtractTypedJsonResponse"
      },
      "FileB64": {
        "properties": {
          "filename": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Filename",
            "default": "upload.bin"
          },
          "content_base64": {
            "type": "string",
            "maxLength": 20971520,
            "minLength": 1,
            "title": "Content Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "content_base64"
        ],
        "title": "FileB64"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "0.3.0"
            ]
          },
          "region": {
            "type": "string",
            "title": "Region",
            "examples": [
              "eu-central-1"
            ]
          },
          "git_commit": {
            "type": "string",
            "title": "Git Commit"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "status",
          "version",
          "region",
          "git_commit",
          "limits"
        ],
        "title": "HealthResponse"
      },
      "JsonValue": {},
      "Limits": {
        "properties": {
          "max_files": {
            "type": "integer",
            "title": "Max Files"
          },
          "max_pages": {
            "type": "integer",
            "title": "Max Pages"
          },
          "max_file_mb": {
            "type": "number",
            "title": "Max File Mb"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "max_files",
          "max_pages",
          "max_file_mb"
        ],
        "title": "Limits"
      },
      "SchemaIssue": {
        "properties": {
          "path": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Path"
          },
          "keyword": {
            "type": "string",
            "title": "Keyword"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "keyword"
        ],
        "title": "SchemaIssue"
      },
      "SessionResponse": {
        "properties": {
          "accessKeyId": {
            "type": "string",
            "title": "Accesskeyid"
          },
          "secretAccessKey": {
            "type": "string",
            "title": "Secretaccesskey"
          },
          "sessionToken": {
            "type": "string",
            "title": "Sessiontoken"
          },
          "expiration": {
            "type": "string",
            "title": "Expiration"
          },
          "region": {
            "type": "string",
            "title": "Region"
          },
          "functionUrl": {
            "type": "string",
            "title": "Functionurl"
          },
          "service": {
            "type": "string",
            "const": "lambda",
            "title": "Service"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "accessKeyId",
          "secretAccessKey",
          "sessionToken",
          "expiration",
          "region",
          "functionUrl",
          "service"
        ],
        "title": "SessionResponse"
      },
      "SourcePage": {
        "properties": {
          "source_file": {
            "type": "string",
            "title": "Source File"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "source_sha256": {
            "type": "string",
            "title": "Source Sha256"
          },
          "page_sha256": {
            "type": "string",
            "title": "Page Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_file",
          "page",
          "source_sha256",
          "page_sha256"
        ],
        "title": "SourcePage"
      }
    }
  }
}
