        ],
        "summary": "Classify Json",
        "description": "Discover document types per page from the supplied catalog; no attribute extraction.",
        "operationId": "classify_json_classify_json_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassifyJsonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
